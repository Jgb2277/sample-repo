# DineGo Mobile - Environment Variables Template
# Copy to .env for local development

# Base URL for the FastAPI backend (use your machine's local IP when testing on physical device, e.g. http://192.168.1.50:8000)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Demo Mode toggle: set to true to test UI flows without a running backend.
# In demo mode, auth is simulated and clearly marked as offline/demo.
EXPO_PUBLIC_DEMO_MODE=true

# Google Maps Platform API Key (Phase 2)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
